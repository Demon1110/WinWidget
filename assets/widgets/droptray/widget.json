{
  "id": "winwidget.droptray",
  "name": { "zh-TW": "檔案收集匣", "zh-CN": "文件收集匣", "en": "File shelf" },
  "description": {
    "zh-TW": "把要用的檔案或資料夾拖進來收著，一點就開；資料夾就是快速開目錄",
    "zh-CN": "把要用的文件或文件夹拖进来收着，一点就开；文件夹就是快速打开目录",
    "en": "Drag files or folders onto the shelf, click to open; a folder just opens in Explorer"
  },
  "version": "1.1.0",
  "author": "WinWidget",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "productivity",
  "preview": "preview/{theme}.{lang}.webp",
  "size": { "width": 320, "height": 300, "minWidth": 220, "minHeight": 150, "maxWidth": 760, "maxHeight": 900, "grow": 0.4 },
  "permissions": ["shell.launch", "shell.open", "shell.drop"],
  "settings": [
    { "key": "limit", "type": "slider", "label": { "zh-TW": "最多收藏", "zh-CN": "最多收藏", "en": "Shelf size" },
      "default": 20, "min": 5, "max": 40, "step": 5 }
  ]
}
