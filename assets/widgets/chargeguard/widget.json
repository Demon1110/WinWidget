{
  "id": "winwidget.chargeguard",
  "name": { "zh-TW": "充電守衛", "zh-CN": "充电守卫", "en": "Charge guard" },
  "description": {
    "zh-TW": "盯著電量，到 80% 就提醒你拔線，順便看看離目標還有多遠。",
    "zh-CN": "盯着电量，到 80% 就提醒你拔线，顺便看看离目标还有多远。",
    "en": "Watches the battery and pings you at 80% so you can unplug in time."
  },
  "version": "1.1.0",
  "author": "WinWidget",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "system",
  "preview": "preview/instrument.zh-TW.webp",
  "size": { "width": 280, "height": 200, "minWidth": 220, "minHeight": 160, "resizable": true, "grow": 0.28 },
  "permissions": ["system", "notify"],
  "settings": [
    {
      "key": "target",
      "type": "slider",
      "label": { "zh-TW": "目標電量（%）", "zh-CN": "目标电量（%）", "en": "Target charge (%)" },
      "description": { "zh-TW": "一般建議 80%，電池更耐用", "zh-CN": "一般建议 80%，电池更耐用", "en": "80% is the usual sweet spot for battery life" },
      "default": 80,
      "min": 50,
      "max": 100,
      "step": 5
    },
    {
      "key": "remind",
      "type": "toggle",
      "label": { "zh-TW": "到目標時通知", "zh-CN": "到目标时通知", "en": "Notify at the target" },
      "description": { "zh-TW": "每次插上都只提醒一次", "zh-CN": "每次插上都只提醒一次", "en": "Once per charge cycle" },
      "default": true
    }
  ]
}
