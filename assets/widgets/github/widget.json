{
  "id": "winwidget.github",
  "name": { "zh-TW": "GitHub 動態", "zh-CN": "GitHub 动态", "en": "GitHub feed" },
  "description": {
    "zh-TW": "盯一個倉庫的公開動態：推送、issue、PR、發版，滑一眼就知道專案還在動。",
    "zh-CN": "盯一个仓库的公开动态：推送、issue、PR、发版，滑一眼就知道项目还在动。",
    "en": "Watches one public repo: pushes, issues, PRs and releases, newest first."
  },
  "version": "1.1.0",
  "author": "WinWidget",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "productivity",
  "preview": "preview/instrument.zh-TW.webp",
  "size": { "width": 320, "height": 290, "minWidth": 260, "minHeight": 210, "resizable": true, "grow": 0.38 },
  "permissions": ["network:api.github.com"],
  "settings": [
    {
      "key": "repo",
      "type": "text",
      "label": { "zh-TW": "倉庫", "zh-CN": "仓库", "en": "Repository" },
      "description": { "zh-TW": "用 owner/repo 格式，例如 rust-lang/rust", "zh-CN": "用 owner/repo 格式，例如 rust-lang/rust", "en": "owner/repo, for example rust-lang/rust" },
      "default": "rust-lang/rust",
      "placeholder": "owner/repo"
    },
    {
      "key": "refresh",
      "type": "slider",
      "label": { "zh-TW": "更新間隔（分鐘）", "zh-CN": "更新间隔（分钟）", "en": "Refresh every (minutes)" },
      "description": { "zh-TW": "未登入時 GitHub 每小時只給 60 次", "zh-CN": "未登录时 GitHub 每小时只给 60 次", "en": "Anonymous GitHub allows 60 requests an hour" },
      "default": 15,
      "min": 5,
      "max": 60,
      "step": 5
    },
    {
      "key": "count",
      "type": "slider",
      "label": { "zh-TW": "顯示幾條", "zh-CN": "显示几条", "en": "Entries shown" },
      "description": { "zh-TW": "太多就要滾動", "zh-CN": "太多就要滚动", "en": "More entries mean scrolling" },
      "default": 6,
      "min": 3,
      "max": 10,
      "step": 1
    }
  ]
}
