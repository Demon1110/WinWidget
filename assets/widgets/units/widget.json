{
  "id": "winwidget.units",
  "name": { "zh-TW": "單位換算", "zh-CN": "单位换算", "en": "Unit converter" },
  "description": {
    "zh-TW": "長度、重量、溫度、資料量，隨手換算",
    "zh-CN": "长度、重量、温度、数据量，随手换算",
    "en": "Length, weight, temperature, data size — converted as you type"
  },
  "version": "1.0.0",
  "author": "WinWidget",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "productivity",
  "preview": "preview/{theme}.{lang}.webp",
  "size": { "width": 320, "height": 300, "minWidth": 220, "minHeight": 190, "maxWidth": 760, "maxHeight": 900, "grow": 0.45 },
  "permissions": [],
  "settings": [
    { "key": "digits", "type": "select", "label": { "zh-TW": "小數位", "zh-CN": "小数位", "en": "Decimals" }, "default": "auto",
      "options": [
        { "value": "auto", "label": { "zh-TW": "自動", "zh-CN": "自动", "en": "Auto" } },
        { "value": "2", "label": { "zh-TW": "2 位", "zh-CN": "2 位", "en": "2 digits" } },
        { "value": "4", "label": { "zh-TW": "4 位", "zh-CN": "4 位", "en": "4 digits" } },
        { "value": "6", "label": { "zh-TW": "6 位", "zh-CN": "6 位", "en": "6 digits" } }
      ] }
  ]
}

