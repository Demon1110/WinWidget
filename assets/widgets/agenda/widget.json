{
  "id": "winwidget.agenda",
  "name": { "zh-TW": "議程計時器", "zh-CN": "议程计时器", "en": "Agenda timer" },
  "description": {
    "zh-TW": "把會議拆成幾段，每段給一個分鐘數；跑起來就只看當前這一段還剩多少。",
    "zh-CN": "把会议拆成几段，每段给一个分钟数；跑起来就只看当前这一段还剩多少。",
    "en": "Split the meeting into slices with a minute budget and watch only the current one."
  },
  "version": "1.1.0",
  "author": "WinWidget",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "time",
  "preview": "preview/instrument.zh-TW.webp",
  "size": { "width": 320, "height": 300, "minWidth": 260, "minHeight": 220, "resizable": true, "grow": 0.38 },
  "permissions": ["notify"],
  "settings": [
    {
      "key": "beep",
      "type": "toggle",
      "label": { "zh-TW": "段落結束時通知", "zh-CN": "段落结束时通知", "en": "Notify when a slice ends" },
      "description": { "zh-TW": "每段只提醒一次", "zh-CN": "每段只提醒一次", "en": "Once per slice" },
      "default": true
    }
  ]
}
