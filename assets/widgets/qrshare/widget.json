{
  "id": "winwidget.qrshare",
  "name": { "zh-TW": "QR 分享", "zh-CN": "QR 分享", "en": "QR share" },
  "description": {
    "zh-TW": "把文字或網址變成掃得動的二維碼",
    "zh-CN": "把文字或网址变成扫得动的二维码",
    "en": "Turn text or a link into a scannable code"
  },
  "version": "1.0.0",
  "author": "WinWidget",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "productivity",
  "preview": "preview/{theme}.{lang}.webp",
  "size": { "width": 300, "height": 380, "minWidth": 200, "minHeight": 220, "maxWidth": 700, "maxHeight": 900, "grow": 0.35 },
  "permissions": ["clipboard"],
  "settings": [
    { "key": "ecc", "type": "select", "label": { "zh-TW": "容錯等級", "zh-CN": "容错等级", "en": "Error correction" }, "default": "M",
      "options": [
        { "value": "L", "label": { "zh-TW": "低 (7%)", "zh-CN": "低 (7%)", "en": "Low (7%)" } },
        { "value": "M", "label": { "zh-TW": "中 (15%)", "zh-CN": "中 (15%)", "en": "Medium (15%)" } }
      ] }
  ]
}
