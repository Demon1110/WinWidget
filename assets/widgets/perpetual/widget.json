{
  "id": "fullwidget.perpetual",
  "name": { "zh-TW": "萬年曆", "zh-CN": "万年历", "en": "Perpetual calendar" },
  "description": {
    "zh-TW": "可跳到任一年月的月曆，附農曆、節氣、建除十二神與宜忌",
    "zh-CN": "可跳到任一年月的月历，附农历、节气、建除十二神与宜忌",
    "en": "Browse any month or year, with Chinese lunar dates, solar terms and an almanac"
  },
  "version": "1.0.0",
  "author": "FullWidget",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "time",
  "preview": "preview/{theme}.{lang}.webp",
  "size": { "width": 380, "height": 470, "minWidth": 320, "minHeight": 420, "maxWidth": 760, "maxHeight": 900, "grow": 1 },
  "permissions": [],
  "settings": [
    { "key": "weekStart", "type": "select", "label": { "zh-TW": "每週第一天", "zh-CN": "每周第一天", "en": "Week starts on" }, "default": "monday",
      "options": [
        { "value": "monday", "label": { "zh-TW": "星期一", "zh-CN": "星期一", "en": "Monday" } },
        { "value": "sunday", "label": { "zh-TW": "星期日", "zh-CN": "星期日", "en": "Sunday" } }
      ] },
    { "key": "showLunar", "type": "toggle", "label": { "zh-TW": "顯示農曆與節氣", "zh-CN": "显示农历与节气", "en": "Show lunar dates and solar terms" }, "default": true },
    { "key": "showAlmanac", "type": "toggle", "label": { "zh-TW": "顯示建除與宜忌", "zh-CN": "显示建除与宜忌", "en": "Show the almanac (建除, 宜忌)" }, "default": true },
    { "key": "showQuote", "type": "toggle", "label": { "zh-TW": "顯示每日一言", "zh-CN": "显示每日一言", "en": "Show the daily saying" }, "default": true }
  ]
}
